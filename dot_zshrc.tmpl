# Personal Zsh configuration file.

# Ensure Homebrew is in PATH on Apple Silicon / macOS.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Extend PATH.
path=(~/bin ~/.local/bin $path)
typeset -U path

# Export environment variables.
export GPG_TTY=$TTY
export VISUAL='nvim'
export EDITOR="$VISUAL"
export CLICOLOR=1

# Activate mise if installed.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# pnpm
if [[ -d "$HOME/Library/pnpm" ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
  path=("$PNPM_HOME" $path)
fi

# nvm
if [[ -d "$HOME/.nvm" ]]; then
  export NVM_DIR="$HOME/.nvm"
  [[ -s "$NVM_DIR/nvm.sh" ]] && \. "$NVM_DIR/nvm.sh"
  [[ -s "$NVM_DIR/bash_completion" ]] && \. "$NVM_DIR/bash_completion"
fi

# pyenv
if [[ -d "$HOME/.pyenv" ]]; then
  export PYENV_ROOT="$HOME/.pyenv"
  path=("$PYENV_ROOT/bin" $path)
  if (( $+commands[pyenv] )); then
    eval "$(pyenv init --path)"
    eval "$(pyenv init -)"
  fi
fi

{{- if eq .chezmoi.hostname "raymonds-Apple-MacBook-Pro" }}
export DEVELOPER_NAME=Shraymonks
export PANTS_LINT=true
export REMOTE_PRIVATE_KEY_FILE="$HOME/.ssh/id_ed25519"
{{- end}}

# Source additional local files if they exist.
[[ -f ~/.env.zsh ]] && source ~/.env.zsh

# History configuration (replaces z4h defaults).
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY          # Record timestamp in history
setopt SHARE_HISTORY             # Share history between all sessions
setopt HIST_EXPIRE_DUPS_FIRST    # Expire duplicate entries first when trimming history
setopt HIST_IGNORE_DUPS          # Do not record an entry that was just recorded again
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate
setopt HIST_IGNORE_SPACE         # Do not record an entry starting with a space
setopt HIST_SAVE_NO_DUPS         # Do not write duplicate entries in the history file

# Directory navigation & completion shell options.
setopt AUTO_PUSHD                # Push old directory onto the stack on cd
setopt PUSHD_IGNORE_DUPS         # Do not store duplicates in the directory stack
setopt PUSHD_SILENT              # Do not print directory stack after pushd or popd
setopt GLOB_DOTS                 # Include dotfiles in globbing and completions
setopt INTERACTIVE_COMMENTS      # Allow comments in interactive shell

# Antidote plugin manager setup.
zstyle ':antidote:bundle' use-friendly-names 'yes'
ANTIDOTE_HOME="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-$HOME/Library/Caches}/antidote}"
if [[ -d "$ANTIDOTE_HOME/zsh-users/zsh-completions/src" ]]; then
  fpath=("$ANTIDOTE_HOME/zsh-users/zsh-completions/src" $fpath)
fi

# Initialize completions before loading fzf-tab and syntax/autosuggestion plugins.
autoload -Uz compinit
compinit -C

# Load plugins via Antidote.
if [[ -f "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote/antidote.zsh" ]]; then
  source "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote/antidote.zsh"
  antidote load
fi

# fzf-tab configuration (replaces :z4h:fzf-complete).
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' switch-group '<' '>'

# Enable fzf keybindings (Ctrl+R history, Ctrl+T files, Option+C cd).
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi

# Key bindings (Emacs mode, matching previous z4h bindings).
bindkey -e

# Up/Down arrow prefix history search.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Undo / Redo.
bindkey '^_'   undo  # Ctrl+/
bindkey '^[[Z' undo  # Shift+Tab
bindkey '^[/'  redo  # Option+/

# Option+Left / Option+Right word navigation (macOS keyboard).
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[b'     backward-word
bindkey '^[f'     forward-word

# Directory navigation widgets (replaces z4h-cd-back/forward/up/down).
function _redraw_prompt() {
  local f
  for f in $precmd_functions; do
    "$f"
  done
  zle reset-prompt
}

function _cd_back() {
  pushd -q +1 2>/dev/null && _redraw_prompt
}
function _cd_forward() {
  pushd -q -0 2>/dev/null && _redraw_prompt
}
function _cd_up() {
  cd .. 2>/dev/null && _redraw_prompt
}
function _cd_down() {
  if (( $+commands[fzf] )); then
    local dir
    dir=$(command find -L . -mindepth 1 -maxdepth 3 -type d -not -path '*/.*' 2>/dev/null | sed 's|^\./||' | fzf --height 40% --reverse --prompt="cd> ")
    if [[ -n "$dir" ]]; then
      cd -- "$dir" && _redraw_prompt
    else
      zle reset-prompt
    fi
  fi
}
zle -N _cd_back
zle -N _cd_forward
zle -N _cd_up
zle -N _cd_down

bindkey '^[[1;2D' _cd_back     # Shift+Left: cd into the previous directory
bindkey '^[[1;2C' _cd_forward  # Shift+Right: cd into the next directory
bindkey '^[[1;2A' _cd_up       # Shift+Up: cd into the parent directory
bindkey '^[[1;2B' _cd_down     # Shift+Down: cd into a child directory

# Autoload functions.
autoload -Uz zmv

# Define functions and completions.
function md() { [[ $# == 1 ]] && mkdir -p -- "$1" && cd -- "$1" }
compdef _directories md

# Define aliases.
alias tree='tree -a -I .git'
alias ls="${aliases[ls]:-ls} -A"

# Initialize Starship prompt.
if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi
